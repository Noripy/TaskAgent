{
  "name": "@taskagent/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cloudflare Worker: Hono API + React SPA (static assets) + Cron digest job",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "vite build && wrangler deploy",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.client.json && tsc -p tsconfig.node.json",
    "test": "vitest run --config vitest.unit.config.ts && vitest run --config vitest.workers.config.ts",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:workers": "vitest run --config vitest.workers.config.ts",
    "test:watch": "vitest --config vitest.unit.config.ts",
    "db:migrate:local": "wrangler d1 migrations apply taskagent-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply taskagent-db --remote",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.7.5",
    "@taskagent/core": "workspace:*",
    "hono": "^4.13.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.11",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260917.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.1.4",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.11",
    "wrangler": "^4.133.0",
    "@types/node": "^22.19.0"
  }
}
