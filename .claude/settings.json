{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm install)",
      "Bash(pnpm install:*)",
      "Bash(pnpm test:*)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm typecheck:*)",
      "Bash(pnpm verify:*)",
      "Bash(pnpm build:*)",
      "Bash(pnpm --filter:*)",
      "Bash(pnpm exec vitest:*)",
      "Bash(pnpm exec tsc:*)",
      "Bash(pnpm exec biome:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git worktree:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(rg:*)",
      "Bash(grep:*)"
    ],
    "deny": [
      "Read(./.dev.vars)",
      "Read(./apps/web/.dev.vars)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./apps/web/worker-configuration.d.ts)",
      "Read(./pnpm-lock.yaml)",
      "Bash(wrangler secret:*)",
      "Bash(pnpm deploy:*)",
      "Bash(wrangler deploy:*)",
      "Bash(pnpm db:migrate:remote:*)",
      "Bash(git push --force:*)",
      "Bash(rm -rf:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/format-changed.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/guard-migrations.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
